STREAM_ID=""
SHEET_ID=""
EMAIL_SHEET_ID=""

# Optional: substrings of the USB product strings used by start_ffmpeg.sh
# to pick which device is video and which is audio. Case-insensitive.
# Defaults are "UGREEN" and "KT USB Audio".
#VIDEO_USB_NAME="UGREEN"
#AUDIO_USB_NAME="KT USB Audio"

# Optional: number of channels the ALSA capture device exposes.
# 1 for mono USB dongles (most), 2 for stereo interfaces. Default 1.
#AUDIO_CHANNELS=1